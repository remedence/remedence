REMEDENCE_IMAGE=ghcr.io/example/remedence@sha256:replace-with-image-digest
REMEDENCE_CLAMAV_IMAGE=clamav/clamav:1.5.4-debian13-slim@sha256:replace-with-image-digest
REMEDENCE_CADDY_IMAGE=caddy:2.11.4-alpine@sha256:replace-with-image-digest
REMEDENCE_POSTGRES_IMAGE=postgres:18.1-bookworm@sha256:replace-with-image-digest
REMEDENCE_POSTGRES_PASSWORD=replace-with-a-long-random-password
REMEDENCE_DATABASE_URL=postgresql://remedence:replace-with-a-long-random-password@postgres:5432/remedence
REMEDENCE_HOSTNAME=remedence.example.com
REMEDENCE_API_HOST=0.0.0.0
REMEDENCE_AUTH_MODE=required
BETTER_AUTH_URL=https://remedence.example.com
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
REMEDENCE_REQUIRE_MFA=true
REMEDENCE_WORKSPACE_MODE=empty
REMEDENCE_EVIDENCE_SIGNING_KEY=replace-with-at-least-32-random-characters
REMEDENCE_MALWARE_SCANNER=clamav
REMEDENCE_CLAMAV_HOST=clamav
REMEDENCE_CLAMAV_PORT=3310
REMEDENCE_VERIFICATION_PROFILES_PATH=/var/lib/remedence/verification-profiles.json
REMEDENCE_WORKER_RECEIPT_SIGNING_KEY=replace-with-at-least-32-random-characters
REMEDENCE_INTEGRATION_ENCRYPTION_KEYS=1:replace-with-base64-encoded-32-byte-key
