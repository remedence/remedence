{
  "name": "remedence",
  "version": "0.1.0",
  "packageManager": "bun@1.4.0",
  "description": "Open-source remediation verification, evidence, and reporting infrastructure.",
  "private": true,
  "homepage": "https://github.com/remedence/remedence#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/remedence/remedence.git"
  },
  "bugs": {
    "url": "https://github.com/remedence/remedence/issues"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && bun run --filter @remedence/web build",
    "start": "node --enable-source-maps apps/api/dist/server.js",
    "test": "bun run --workspaces --if-present test",
    "test:contract": "vitest run tests/contract",
    "typecheck": "tsc -b --pretty false && bun run --filter @remedence/web typecheck",
    "lint": "oxlint apps packages scripts tests playwright.config.ts --deny-warnings",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "e2e": "node scripts/e2e.mjs",
    "generate:api": "bun run --filter @remedence/openapi-codegen generate",
    "check:generated-api": "node scripts/check-generated-api.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:seed": "node scripts/db-seed.mjs",
    "db:backup": "node scripts/db-backup.mjs",
    "db:restore": "node scripts/db-restore.mjs",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test:contract && bun run test && bun run build && bun run check:generated-api && bun run e2e"
  },
  "engines": {
    "bun": ">=1.4.0 <2",
    "node": ">=24.15.0 <27"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "auth": "1.7.1",
    "jsdom": "^30.0.1",
    "oxlint": "^1.79.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "yaml": "2.9.0"
  }
}
